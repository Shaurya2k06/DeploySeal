# Copy to /etc/deployseal/server.env and replace every placeholder.
DEPLOYSEAL_PROVIDER=aws-cloudformation
AWS_REGION=replace-me
DEPLOYSEAL_CF_STACK=replace-me
DEPLOYSEAL_CF_CHANGE_SET=replace-me
DEPLOYSEAL_CF_ARTIFACT_PARAMETER=DeploySealArtifactDigest
DEPLOYSEAL_KMS_KEY_ID=replace-me
DEPLOYSEAL_ENCLAVE_MEASUREMENT=replace-me
DEPLOYSEAL_PROVIDER_ID=aws-cloudformation

DEPLOYSEAL_STATE_PATH=/var/lib/deployseal/state.sqlite
DEPLOYSEAL_MIDNIGHT_CONTRACT_ADDRESS=loaded-by-start-script
DEPLOYSEAL_MIDNIGHT_SEED_HEX=loaded-by-start-script
DEPLOYSEAL_MIDNIGHT_PRIVATE_STATE_PASSWORD=loaded-by-start-script
DEPLOYSEAL_PRIVATE_POLICY_SALT_HEX=loaded-by-start-script
DEPLOYSEAL_POLICY_JSON=loaded-by-start-script
DEPLOYSEAL_EVIDENCE_JSON=loaded-by-start-script
DEPLOYSEAL_EVIDENCE_FACTS_JSON=loaded-by-start-script
DEPLOYSEAL_EVIDENCE_ADAPTER_PUBLIC_KEY=loaded-by-start-script
DEPLOYSEAL_BUILD_FACT_JSON=loaded-by-start-script
DEPLOYSEAL_BUILD_ADAPTER_PUBLIC_KEY=loaded-by-start-script

HOST=127.0.0.1
PORT=8787
CLIENT_ORIGIN=https://replace-with-client-origin
DEPLOYSEAL_REQUIRE_AUTH=true
DEPLOYSEAL_API_TOKEN=loaded-by-start-script
DEPLOYSEAL_REQUIRE_TLS=true
DEPLOYSEAL_TLS_KEY_FILE=/etc/deployseal/tls/server.key
DEPLOYSEAL_TLS_CERT_FILE=/etc/deployseal/tls/server.crt
