[Unit]
Description=DeploySeal AWS broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deployseal
Group=deployseal
WorkingDirectory=/opt/deployseal
EnvironmentFile=/etc/deployseal/server.env
ExecStart=/bin/sh /opt/deployseal/ops/aws/start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
